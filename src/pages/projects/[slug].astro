---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate } from "@/lib/utils";
import { getAllPosts } from "@/lib/db";
import { resolvePostImages, resolveHtmlMedia } from "@/lib/images";
import { marked } from "marked";

export async function getStaticPaths() {
  const rawProjects = await getAllPosts("project");
  const projects = await resolvePostImages(rawProjects, "project");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

let contentHtml = await marked.parse(project.content || "");
contentHtml = await resolveHtmlMedia(contentHtml, project.slug, "project");

contentHtml = contentHtml.replace(
  /<a href="([^"]+#\.mp4|[^"]+\.(?:mp4|mov|webm|ogg))"[^>]*>([^<]*)<\/a>/gi,
  (_match, url) => {
    const cleanUrl = url.replace("#.mp4", "");
    return `<video controls src="${cleanUrl}" style="width: 100%; max-width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--border); margin: 1.25rem 0;"></video>`;
  },
);

const ogImage =
  project.image || `/og?title=${encodeURIComponent(project.title)}`;
const wordCount = (project.content || "").trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 220));
---

<BaseLayout
  title={project.title}
  description={project.summary || undefined}
  image={ogImage || undefined}
  compactHeader={true}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        headline: project.title,
        datePublished: project.publishedAt
          ? project.publishedAt.toISOString()
          : new Date().toISOString(),
        dateModified: project.publishedAt
          ? project.publishedAt.toISOString()
          : new Date().toISOString(),
        description: project.summary,
        image: project.image || ogImage,
        url: new URL(Astro.url.pathname, Astro.site).href,
        author: {
          "@type": "Person",
          name: "Ved Gupta Portfolio",
        },
      })}
    />
  </Fragment>

  <section class="mt-6">
    <a
      href="/projects/"
      class="inline-flex items-center gap-1 text-[12px] font-medium text-[var(--ink-muted)] hover:text-[var(--ink-primary)] transition-colors mb-4"
    >
      ← Back to Projects
    </a>

    <h1 class="title text-[22px] font-semibold tracking-[-0.02em] leading-snug text-[var(--ink-primary)]">
      {project.title}
    </h1>

    {
      project.summary && (
        <p class="mt-2 text-[14px] text-[var(--ink-secondary)] leading-relaxed">
          {project.summary}
        </p>
      )
    }

    <div class="mt-3 pb-5 border-b border-[var(--border)] flex items-center gap-2 font-mono-meta text-[12px] text-[var(--ink-muted)] tabular-nums">
      <time>{formatDate(project.publishedAt)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime} min read</span>
      <span aria-hidden="true">·</span>
      <span>Ved Prakash Gupta</span>
    </div>

    <article class="prose mt-6" set:html={contentHtml} />
  </section>
</BaseLayout>
