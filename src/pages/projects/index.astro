---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectPosts from "@/components/ProjectPosts.astro";
---

<BaseLayout
  title="Projects"
  description="A list of projects by Ved Gupta (innovatorved | vedgupta)."
>
  <section class="mt-6">
    <div class="flex items-center justify-between gap-3 mb-4">
      <h2 class="text-[16px] font-semibold text-[var(--ink-primary)]">
        My Projects
      </h2>
      <a
        href="https://github.com/innovatorved"
        target="_blank"
        rel="noopener noreferrer"
        data-event="social_click"
        data-platform="github"
        data-link-url="https://github.com/innovatorved"
        class="pl-btn"
      >
        GitHub @innovatorved ↗
      </a>
    </div>
    <ProjectPosts />
  </section>
</BaseLayout>
