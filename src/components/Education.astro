---
const education = [
  {
    institution: "Galgotias College of Engineering and Technology",
    degree: "Bachelor of Technology - BTech, Information Technology",
    period: "Aug 2020 - May 2023",
  },
  {
    institution: "Government Polytechnic Bahraich",
    degree: "3 years Technical Diploma",
    period: "2017 - 2020",
  },
];
---

<section class="mt-8">
  <h2 class="text-[16px] font-semibold text-[var(--ink-primary)] mb-4">
    Education
  </h2>

  <div class="space-y-4">
    {
      education.map((edu) => (
        <div>
          <h3 class="text-[14px] font-semibold text-[var(--ink-primary)]">
            {edu.institution}
          </h3>
          <p class="mt-0.5 text-[13px] text-[var(--ink-secondary)]">
            {edu.degree}
          </p>
          <p class="mt-0.5 text-[12px] text-[var(--ink-muted)] tabular-nums">
            {edu.period}
          </p>
        </div>
      ))
    }
  </div>
</section>
