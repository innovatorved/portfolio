---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404 - Page Not Found" robots="noindex, follow" compactHeader={true}>
  <section class="flex flex-col items-center justify-center text-center min-h-[48vh]">
    <h1 class="text-[24px] font-semibold text-[var(--ink-primary)]">
      404 - Page not found
    </h1>
    <p class="mt-2 text-[14px] text-[var(--ink-secondary)] max-w-sm">
      The page you're looking for doesn't exist or may have been moved.
    </p>
    <div class="mt-6 flex items-center gap-2">
      <a href="/" class="pl-btn pl-btn-green">Return Home</a>
      <a href="/projects/" class="pl-btn">Projects</a>
    </div>
  </section>
</BaseLayout>
