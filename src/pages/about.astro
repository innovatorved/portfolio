---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="About Me"
  description="About Ved Gupta (innovatorved) - Cloud Engineer and developer who writes code. Full Stack, Generative AI, Azure, React, Next.js, TypeScript, Docker, and Kubernetes."
>
  <section class="mt-6">
    <h2 class="text-[16px] font-semibold text-[var(--ink-primary)] mb-4">
      About Me
    </h2>

    <figure class="mb-5 overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--bg-subtle)]">
      <img
        src="/static/images/ved-gemini-stage.jpg"
        alt="Ved Gupta speaking on stage at Google Cloud Build with Gemini"
        width="1280"
        height="720"
        class="w-full h-auto block object-cover"
        loading="eager"
      />
      <figcaption class="px-3.5 py-2 text-[12px] text-[var(--ink-muted)] border-t border-[var(--border)]">
        Build with Gemini, 2026
      </figcaption>
    </figure>

    <div class="space-y-3.5 text-[14px] text-[var(--ink-secondary)] leading-[1.7]">
      <p>
        Hi there! I'm a Cloud Engineer and developer who writes code as much as
        I design infrastructure. My journey started in freelancing, where I
        built hands-on expertise in React, Next.js, JavaScript, and TypeScript
        across diverse client projects.
      </p>
      <p>
        I transitioned into a full-time Cloud Engineer role at{" "}
        <strong class="font-medium text-[var(--ink-primary)]">LTIMindtree</strong>,
        where I design and deploy scalable Azure IaaS solutions and also build
        AI-powered apps and agents using Azure OpenAI, writing the application
        code rather than just configuring the infrastructure around it.
      </p>
      <p>
        Beyond client work, I build open-source AI tools myself, end to end,
        including <strong class="font-medium text-[var(--ink-primary)]">Whisper API</strong>{" "}
        (a self-hostable speech-to-text API with 915+ GitHub stars),{" "}
        <strong class="font-medium text-[var(--ink-primary)]">Subtitle Generator</strong>{" "}
        (an automatic video transcription CLI with 440+ stars, published on
        PyPI), and{" "}
        <strong class="font-medium text-[var(--ink-primary)]">Realtime Interview Copilot</strong>{" "}
        (a real-time AI assistant using live audio transcription, 142+ stars).
      </p>
      <p>
        <strong class="font-medium text-[var(--ink-primary)]">Certified:</strong>{" "}
        Microsoft Azure AI Apps and Agents Developer Associate, Azure
        Administrator Associate, Azure AI Fundamentals, Google Cloud Associate
        Cloud Engineer, and Claude Certified Developer.
      </p>
      <p>
        If you're interested in discussing Cloud, Generative AI, or Full Stack
        opportunities, feel free to connect here or reach out at{" "}
        <a
          href="mailto:me@vedgupta.in"
          data-event="contact_email_click"
          data-email="me@vedgupta.in"
          class="text-[var(--ink-primary)] underline decoration-[var(--border-hover)] underline-offset-3 hover:text-[var(--green-ink)] hover:decoration-[var(--green-primary)] transition-colors"
        >
          me@vedgupta.in
        </a>
        .
      </p>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-2">
      <a
        href="mailto:me@vedgupta.in"
        data-event="contact_email_click"
        data-email="me@vedgupta.in"
        class="pl-btn pl-btn-green"
      >
        Email me@vedgupta.in
      </a>
      <a href="/projects/" class="pl-btn">Projects</a>
      <a href="/certifications/" class="pl-btn">Credentials</a>
      <a href="/resume/" class="pl-btn">Resume</a>
    </div>
  </section>
</BaseLayout>
