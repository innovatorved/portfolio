---
import { getAllPosts } from "@/lib/db";
import { formatDate } from "@/lib/utils";

interface Props {
  limit?: number;
}

const { limit } = Astro.props;

const rawPosts = await getAllPosts("blog");
const posts = limit ? rawPosts.slice(0, limit) : rawPosts;
---

{
  posts.length === 0 ? (
    <p class="text-[13px] text-[var(--ink-muted)] py-4">
      No posts published yet.
    </p>
  ) : (
    <div class="flex flex-col gap-2.5">
      {posts.map((post) => (
        <a
          href={`/blog/${post.slug}/`}
          class="group pl-card px-4 py-3.5 flex items-start justify-between gap-4"
          data-event="blog_post_click"
          data-post-title={post.title}
          data-post-slug={post.slug}
        >
          <div class="min-w-0 flex-1">
            <h3 class="text-[14px] font-semibold leading-5 text-[var(--ink-primary)] group-hover:text-[var(--green-ink)] transition-colors">
              {post.title}
            </h3>
            {post.summary && (
              <p class="mt-1 text-[12.5px] leading-[1.5] text-[var(--ink-secondary)] line-clamp-2">
                {post.summary}
              </p>
            )}
          </div>
          <time class="shrink-0 font-mono-meta text-[11.5px] text-[var(--ink-muted)] tabular-nums mt-0.5">
            {formatDate(post.publishedAt)}
          </time>
        </a>
      ))}
    </div>
  )
}
