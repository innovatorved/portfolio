---
const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    href: "https://peerlist.io/u/innovatorved",
    label: "Peerlist",
    platform: "peerlist",
    eventType: "social_click",
  },
  {
    href: "https://github.com/innovatorved",
    label: "GitHub",
    platform: "github",
    eventType: "social_click",
  },
  {
    href: "https://twitter.com/innovatorved",
    label: "X",
    platform: "twitter",
    eventType: "social_click",
  },
  {
    href: "https://linkedin.com/in/innovatorved",
    label: "LinkedIn",
    platform: "linkedin",
    eventType: "social_click",
  },
  {
    href: "https://status.vedgupta.in/",
    label: "Status",
    platform: "",
    eventType: "outbound_click",
  },
  {
    href: "/rss.xml",
    label: "RSS",
    platform: "",
    eventType: "footer_click",
  },
];
---

<footer class="mt-14 pt-6 pb-10 border-t border-[var(--border)] text-center">
  <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
    {
      socialLinks.map(({ href, label, platform, eventType }) => {
        const external = href.startsWith("http");
        return (
          <a
            href={href}
            data-event={eventType}
            data-link-text={label}
            data-link-url={href}
            data-platform={platform}
            {...(external
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
            class="text-[12px] font-medium text-[var(--ink-muted)] hover:text-[var(--ink-primary)] transition-colors"
          >
            {label}
          </a>
        );
      })
    }
  </div>

  <div class="mt-4 flex items-center justify-center gap-2 text-[12px] text-[var(--ink-muted)]">
    <span>© {currentYear}</span>
    <img
      src="/static/images/vedgupta-avatar.jpg"
      alt=""
      width="18"
      height="18"
      class="h-[18px] w-[18px] rounded-full object-cover border border-[var(--border)]"
    />
    <span class="text-[var(--ink-primary)] font-medium">Ved Gupta</span>
    <span aria-hidden="true">·</span>
    <Fragment set:html="<!--email_off-->" />
    <a
      href="mailto:me@vedgupta.in"
      data-event="contact_email_click"
      data-email="me@vedgupta.in"
      class="hover:text-[var(--ink-primary)] transition-colors"
    >
      me@vedgupta.in
    </a>
    <Fragment set:html="<!--/email_off-->" />
  </div>
</footer>
