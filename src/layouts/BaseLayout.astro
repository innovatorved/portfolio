---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
  compactHeader?: boolean;
}

const {
  title = "Ved Gupta Portfolio",
  description = "Cloud Engineer | Full Stack & Generative AI Developer | Building on Azure with React, Next.js, TypeScript, Python | Azure & Google Cloud Certified | innovatorved | vedgupta",
  image = "/static/images/innovatorved-banner-2.png",
  robots = "index, follow",
  compactHeader = false,
} = Astro.props;

const rawPath = Astro.url.pathname;
const pathname = rawPath.endsWith("/") ? rawPath : `${rawPath}/`;
const canonicalURL = new URL(pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("color-scheme");
          var meta = document.querySelector('meta[name="color-scheme"]');
          var value =
            stored === "light" || stored === "dark" ? stored : "light dark";
          if (meta) meta.content = value;
          document.documentElement.style.colorScheme =
            stored === "light" || stored === "dark" ? stored : "";
        } catch (_) {}
      })();
    </script>
    <ClientRouter />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/static/favicons/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/static/favicons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/static/favicons/favicon-16x16.png"
    />
    <link rel="manifest" href="/static/favicons/site.webmanifest" />

    <!-- SEO Meta Tags -->
    <title>{title} | Ved Gupta Portfolio | innovatorved</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Ved Gupta, innovatorved, vedgupta, Full Stack Developer, Cloud Engineer, Azure, Google Cloud, Generative AI, React, Next.js"
    />
    <meta name="author" content="Ved Gupta" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Sitemap and RSS Feed Discovery -->
    <link rel="sitemap" href="/sitemap.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ved Gupta Portfolio - RSS Feed"
      href={new URL("/rss.xml", Astro.site)}
    />

    <!-- Google Verification -->
    <meta
      name="google-site-verification"
      content="GSqcErwd4cAZcW81E5egoyjhg6yENYk_Zu22A0vbtcw"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta
      property="og:site_name"
      content="Ved Gupta Portfolio | innovatorved"
    />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:creator" content="@innovatorved" />

    <!-- Fonts: Geist & Geist Mono (exact Peerlist primary font) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Geist:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Page-specific head content -->
    <slot name="head" />

    <!-- Google Tag Manager -->
    <script is:inline type="text/partytown">
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-NR39J8J");
    </script>
  </head>
  <body class="antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NR39J8J"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 pl-btn pl-btn-green"
    >
      Skip to content
    </a>

    <div class="page-shell">
      <Nav compact={compactHeader} />
      <main id="main-content" class="flex-1 min-w-0">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- Color-scheme toggle + cross-tab sync + Astro view-transition sync -->
    <script>
      function getStoredScheme(): "light" | "dark" | null {
        try {
          const val = localStorage.getItem("color-scheme");
          return val === "light" || val === "dark" ? val : null;
        } catch {
          return null;
        }
      }

      function applySchemeMeta(scheme: "light" | "dark" | null) {
        const meta = document.querySelector<HTMLMetaElement>(
          'meta[name="color-scheme"]',
        );
        if (meta) {
          meta.content = scheme ?? "light dark";
        }
        document.documentElement.style.colorScheme = scheme ?? "";
      }

      function toggleColorScheme() {
        const systemDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const stored = getStoredScheme();
        const currentlyDark = stored ? stored === "dark" : systemDark;
        const target: "light" | "dark" = currentlyDark ? "light" : "dark";
        const systemScheme: "light" | "dark" = systemDark ? "dark" : "light";

        if (target !== systemScheme) {
          try {
            localStorage.setItem("color-scheme", target);
          } catch {}
          applySchemeMeta(target);
        } else {
          try {
            localStorage.removeItem("color-scheme");
          } catch {}
          applySchemeMeta(null);
        }
      }

      function bindThemeToggle() {
        applySchemeMeta(getStoredScheme());
        const btn = document.getElementById("theme-toggle");
        if (!btn || btn.dataset.bound === "true") return;
        btn.dataset.bound = "true";
        btn.addEventListener("click", toggleColorScheme);
      }

      bindThemeToggle();
      document.addEventListener("astro:after-swap", bindThemeToggle);
      document.addEventListener("astro:page-load", bindThemeToggle);

      window.addEventListener("storage", (e: StorageEvent) => {
        if (e.key === "color-scheme") {
          applySchemeMeta(getStoredScheme());
        }
      });
    </script>

    <!-- Analytics Event Handler -->
    <script>
      declare global {
        interface Window {
          dataLayer: Record<string, unknown>[];
        }
      }

      window.dataLayer = window.dataLayer || [];

      document.addEventListener("click", (e: MouseEvent) => {
        const target = e.target as Element | null;
        if (!target) return;

        const closestElement = target.closest("[data-event]");
        if (!closestElement || !(closestElement instanceof HTMLElement)) return;

        const eventData: Record<string, unknown> = {
          event: closestElement.dataset.event,
        };

        for (const [key, value] of Object.entries(closestElement.dataset)) {
          if (key !== "event" && value) {
            const snakeKey = key.replace(/([A-Z])/g, "_$1").toLowerCase();
            eventData[snakeKey] = value;
          }
        }

        window.dataLayer.push(eventData);
      });

      let maxScrollPercent = 0;
      const scrollThresholds = [25, 50, 75, 90, 100];
      const firedThresholds = new Set<number>();

      window.addEventListener("scroll", () => {
        const scrollTop = window.scrollY;
        const docHeight =
          document.documentElement.scrollHeight - window.innerHeight;
        if (docHeight <= 0) return;
        const scrollPercent = Math.round((scrollTop / docHeight) * 100);

        if (scrollPercent > maxScrollPercent) {
          maxScrollPercent = scrollPercent;

          for (const threshold of scrollThresholds) {
            if (scrollPercent >= threshold && !firedThresholds.has(threshold)) {
              firedThresholds.add(threshold);
              window.dataLayer.push({
                event: "scroll_depth",
                percent: threshold,
                page: window.location.pathname,
              });
            }
          }
        }
      });
    </script>
  </body>
</html>
