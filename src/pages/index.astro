---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogPosts from "@/components/BlogPosts.astro";
import Certifications from "@/components/Certifications.astro";
import { certifications } from "@/lib/certifications";
---

<BaseLayout title="Ved Gupta">
  <!-- Availability + Tight 2-Line Intro -->
  <section class="mt-6">
    <div
      class="flex items-center justify-between gap-3 px-3.5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--bg-subtle)]"
    >
      <div class="flex items-start sm:items-center gap-2 min-w-0 flex-1 text-[12.5px] sm:text-[13px] leading-snug text-[var(--ink-primary)]">
        <span
          class="h-2 w-2 rounded-full bg-[var(--green-primary)] shrink-0 mt-1.5 sm:mt-0"
          aria-hidden="true"></span>
        <span>
          Open to Cloud Engineering, DevOps, Full Stack, and Generative AI roles.
        </span>
      </div>
      <a
        href="mailto:me@vedgupta.in"
        data-event="contact_email_click"
        data-email="me@vedgupta.in"
        class="pl-btn pl-btn-green shrink-0 whitespace-nowrap"
      >
        Let's talk
      </a>
    </div>

    <div class="mt-5 space-y-3 text-[13.5px] leading-[1.65] text-[var(--ink-secondary)]">
      <p>
        I started as a freelancer, writing applications with React, Next.js,
        JavaScript, and TypeScript, then grew into DevOps practices,
        containerizing with Docker and orchestrating with Kubernetes to ship
        applications reliably at scale.
      </p>
      <p>
        Currently at <strong class="font-medium text-[var(--ink-primary)]">LTIMindtree</strong>,
        I design and implement scalable Azure cloud infrastructure and write the
        application code that runs on it, building AI-powered apps and agents
        using Azure OpenAI rather than only configuring the infrastructure
        around them.
      </p>
    </div>
  </section>

  <!-- Verified Credentials Preview -->
  <section class="mt-7">
    <div class="flex items-center justify-between gap-3 mb-3.5">
      <h2 class="text-[16px] font-semibold text-[var(--ink-primary)]">
        Verified Credentials
      </h2>
      <a
        href="/certifications/"
        class="text-[12px] font-medium text-[var(--ink-muted)] hover:text-[var(--ink-primary)] transition-colors"
      >
        All {certifications.length} →
      </a>
    </div>
    <Certifications limit={4} compact={true} />
  </section>

  <!-- Recent Posts -->
  <section class="mt-8">
    <div class="flex items-center justify-between gap-3 mb-3.5">
      <h2 class="text-[16px] font-semibold text-[var(--ink-primary)]">
        Recent Posts
      </h2>
      <a
        href="/blog/"
        class="text-[12px] font-medium text-[var(--ink-muted)] hover:text-[var(--ink-primary)] transition-colors"
      >
        View all →
      </a>
    </div>
    <BlogPosts limit={3} />
  </section>
</BaseLayout>
